# ─── Base de Datos ────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/nutricasa
# Nombre de la base de datos para el MongoDB Native Driver (módulo business)
# Si no se especifica, usa 'nutricasa' por defecto
MONGO_DB_NAME=nutricasa

# ─── Autenticación JWT ────────────────────────────────────────────────────────
JWT_SECRET=tu_secreto_jwt_aqui
JWT_REFRESH_SECRET=tu_secreto_refresh_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Email (nodemailer) ───────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password

# ─── Google Gemini AI (recetas con IA) ───────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key

# ─── Upload de imágenes ───────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/
